# Godot 4+ specific ignores
.godot/
/android/

# GDExtension build byproducts. The libraries themselves (.dll/.so/.dylib) are committed so
# the project opens without a C++ toolchain. The web .wasm is rebuilt by tools/export_web.sh.
/bin/*.wasm
/bin/*.lib
/bin/*.exp
/bin/*.pdb
/extension/src/*.obj
/extension/src/*.o
/extension/*.pdb
/extension/.sconsign*.dblite
/bin/*.old.*
/bin/~*

# Exports
/build/
docs/SHIFT.pdf
