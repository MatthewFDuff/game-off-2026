	[0x44, 0x28, 0x10, 0x28, 0x44], [0x0C, 0x50, 0x50, 0x50, 0x3C], [0x44, 0x64, 0x54, 0x4C, 0x44], [0x08, 0x36, 0x41],
	[0x7F], [0x41, 0x36, 0x08], [0x08, 0x04, 0x08, 0x10, 0x08],
