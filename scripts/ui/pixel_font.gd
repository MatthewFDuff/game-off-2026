## Characters past ASCII: code point -> columns.
const EXTRA := {
	0x221E: [0x1C, 0x22, 0x14, 0x08, 0x14, 0x22, 0x1C], # infinity
	0x2014: [0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08], # em dash
	0x2013: [0x08, 0x08, 0x08, 0x08, 0x08], # en dash
	0x2018: [0x03, 0x05], 0x2019: [0x05, 0x03],
	0x201C: [0x03, 0x05, 0x00, 0x03, 0x05], 0x201D: [0x05, 0x03, 0x00, 0x05, 0x03],
	0x2026: [0x40, 0x00, 0x40, 0x00, 0x40], # ellipsis
	0x00B7: [0x08], 0x00D7: [0x22, 0x14, 0x08, 0x14, 0x22], # middle dot, times
}

static var _font: FontFile
static var _theme: Theme


## The font (built once).
static func font() -> FontFile:
	if _font:
		return _font
	var glyphs := {}
	for i in GLYPHS.size():
		glyphs[32 + i] = GLYPHS[i]
	for code: int in EXTRA:
		glyphs[code] = EXTRA[code]
	var width := 0
	for columns: Array in glyphs.values():
		width += columns.size() + 1
	var image := Image.create(width, SIZE, false, Image.FORMAT_LA8)
	var f := FontFile.new()
	f.fixed_size = SIZE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	f.hinting = TextServer.HINTING_NONE
	var size := Vector2i(SIZE, 0)
	var x := 0
	for code: int in glyphs:
		var columns: Array = glyphs[code]
		for c in columns.size():
			for row in ASCENT:
				if int(columns[c]) & (1 << row):
					image.set_pixel(x + c, row, Color.WHITE)
		var w := columns.size()
		f.set_glyph_advance(0, SIZE, code, Vector2(w + 1, 0))
		f.set_glyph_offset(0, size, code, Vector2(0, -ASCENT))
		f.set_glyph_size(0, size, code, Vector2(w, SIZE))
		f.set_glyph_uv_rect(0, size, code, Rect2(x, 0, w, SIZE))
		f.set_glyph_texture_idx(0, size, code, 0)
		x += w + 1
	f.set_texture_image(0, size, 0, image)
	f.set_cache_ascent(0, SIZE, ASCENT)
	f.set_cache_descent(0, SIZE, SIZE - ASCENT)
	f.fallbacks = [ThemeDB.fallback_font]
	_font = f
	return f


## A font size on the pixel grid: the nearest whole multiple of SIZE, at least minimum times.
static func snap(size: int, minimum := 2) -> int:
	return SIZE * maxi(minimum, roundi(float(size) / SIZE))


## Label settings in the pixel font at about size px: a hard one-block drop shadow stands in for an
## outline (outline > 0), since bitmap glyphs have no outline.
static func settings(size: int, color := Color.WHITE, outline := 5, minimum := 2) -> LabelSettings:
	var s := LabelSettings.new()
	s.font = font()
	s.font_size = snap(size, minimum)
	s.font_color = color
	if outline > 0:
		var block := s.font_size / SIZE
		s.shadow_size = 0
		s.shadow_color = Color(0.0, 0.0, 0.0, 0.85)
		s.shadow_offset = Vector2(block, block)
	return s


## A theme whose default font is the pixel font at 16 px (buttons, panels' plain labels).
static func theme() -> Theme:
	if _theme == null:
		_theme = Theme.new()
		_theme.default_font = font()
		_theme.default_font_size = SIZE * 2
	return _theme


## Nearest filtering for a canvas item and (by inheritance) everything under it, so pixel text and
## shapes stay hard-edged when the window scales the canvas.
## Controls without a theme also get theme(), so their buttons use the pixel font.
static func nearest(item: CanvasItem) -> void:
	item.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	if item is Control and (item as Control).theme == null:
		(item as Control).theme = theme()
